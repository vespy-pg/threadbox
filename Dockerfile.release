FROM ubuntu:22.04 AS build

ARG NODE_VERSION=20.19.5
ARG CARGO_BUILD_JOBS=3

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS} \
    PATH=/usr/local/cargo/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    curl \
    libasound2-dev \
    libayatana-appindicator3-dev \
    libclang-dev \
    libdbus-1-dev \
    libpulse-dev \
    librsvg2-dev \
    libwebkit2gtk-4.1-dev \
    patchelf \
    wget \
    xz-utils \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 \
    -o /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1

RUN curl --proto '=https' --tlsv1.2 -o /tmp/rustup-init.sh https://sh.rustup.rs \
    && sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain 1.98.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends file libfuse2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/app/src-tauri/target \
    rm -rf /app/src-tauri/target/release/bundle \
    && cargo test --manifest-path src-tauri/Cargo.toml \
    && npm run tauri build \
    && mkdir -p /app/release-bundle \
    && cp -a /app/src-tauri/target/release/bundle/. /app/release-bundle/
RUN npm run extension:build && npx web-ext build --source-dir dist/extension/firefox --artifacts-dir dist/extension/package

FROM scratch AS artifacts
COPY --from=build /app/release-bundle /linux
COPY --from=build /app/dist/extension /extension
